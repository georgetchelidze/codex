%YAML 1.2
---
name: Range
file_extensions:
  - range
scope: source.range

contexts:
  main:
    - include: comments
    - include: strings

    - match: '\b(construct|namespace|enum|extension|precedencegroup)\s+([A-Z][A-Za-z0-9_]*)'
      captures:
        1: keyword.declaration.range
        2: entity.name.type.range

    - match: '\b(function)\s+([A-Za-z_][A-Za-z0-9_]*|[!%&*+\-./<=>?^|~]+)'
      captures:
        1: keyword.declaration.function.range
        2: entity.name.function.range

    - match: '\b(macro|marker)\s+([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        1: keyword.declaration.macro.range
        2: entity.name.function.macro.range

    - match: '\b(let|state|binding|derived|var)\s+([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        1: storage.type.range
        2: variable.other.definition.range

    - match: '(@)([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        1: punctuation.definition.annotation.range
        2: storage.type.annotation.range

    - match: '(#)([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        1: punctuation.definition.macro.range
        2: entity.name.function.macro.range

    - match: '\b(true|false)\b'
      scope: constant.language.boolean.range
    - match: '\bnil\b'
      scope: constant.language.nil.range
    - match: '\b\d+\.\d+\b'
      scope: constant.numeric.float.range
    - match: '\b\d+\b'
      scope: constant.numeric.integer.range

    - match: '\b(construct|namespace|enum|case|extension|macro|marker|function|state|binding|derived|let|var|if|else|for|in|while|switch|default|return|break|continue|background|get|set|on|builder|capture|precedencegroup|prefix|infix|postfix|operator|self|init|core|main|package)\b'
      scope: keyword.control.range

    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: storage.type.range
    - match: '(?<=\.)[A-Za-z_][A-Za-z0-9_]*'
      scope: variable.other.member.range
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*:)'
      scope: variable.parameter.label.range
    - match: '[!%&*+\-./<=>?^|~]+'
      scope: keyword.operator.range

  comments:
    - match: '//'
      scope: punctuation.definition.comment.range
      push:
        - meta_scope: comment.line.double-slash.range
        - match: '$'
          pop: true
    - match: '/\*'
      scope: punctuation.definition.comment.begin.range
      push:
        - meta_scope: comment.block.range
        - match: '\*/'
          scope: punctuation.definition.comment.end.range
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.range
      push:
        - meta_scope: string.quoted.double.range
        - match: '\\\('
          scope: punctuation.section.interpolation.begin.range
          push:
            - meta_scope: meta.interpolation.range
            - match: '\)'
              scope: punctuation.section.interpolation.end.range
              pop: true
            - include: main
        - match: '\\.'
          scope: constant.character.escape.range
        - match: '"'
          scope: punctuation.definition.string.end.range
          pop: true
